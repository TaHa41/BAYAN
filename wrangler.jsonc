{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayan",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bayan-knowledge",
      "database_id": "7f43f467-baec-4770-a5e1-52e65abf348d"
    }
  ],
  "keep_vars": true,
  
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "redactQueryString": true
    },
    "issues": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
