{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayan",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "SEARCH_API_KEY",
      "GNEWS_API_KEY",
      "GOLD_API_KEY"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}