# BAYAN local development only. Never commit real credentials.
BAYAN_ENVIRONMENT=development
BAYAN_VERSION=0.11.0
BAYAN_COMMIT_SHA=local

# AI / search providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SEARCH_API_KEY=
SEARCH_PROVIDER=ceramic
AI_SEARCH_INSTANCE=bayan-knowledge
GNEWS_API_KEY=
GOLD_API_KEY=
WIKIMEDIA_ENTERPRISE_TOKEN=
GOOGLE_MAPS_API_KEY=

# Runtime management and owner diagnostics
BAYAN_AI_MANAGER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional advertising configuration (public identifiers only).
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_HOME_TOP=
ADSENSE_SLOT_SECTION_TOP=
ADSENSE_SLOT_ARTICLE=
ADSENSE_SLOT_HOME_BOTTOM=
