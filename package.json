{
  "name": "bayan",
  "version": "3.0.0",
  "private": true,
  "description": "BAYAN | بيان — Arabic/English information and knowledge platform",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir .wrangler-build",
    "deploy": "wrangler deploy",
    "preview": "wrangler preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "guards": "node scripts/static-guards.mjs",
    "check": "npm run guards && npm run typecheck && node --check public/app.js && npm test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
